{
  "name": "@bb-tournament/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --outfile=dist/index.js",
    "clean": "rm -rf dist dist-test",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && find dist-test -name '*.test.js' -print0 | xargs -0 node --test"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1146.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-presigned-post": "^3.700.0",
    "@bb-tournament/shared": "*",
    "hono": "^4.6.13",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.146",
    "@types/node": "^22.10.1",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
}
